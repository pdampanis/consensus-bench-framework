@inproceedings{howard_paxos_2020,
	address = {Heraklion, Greece},
	title = {Paxos vs {Raft}: {Have} {We} {Reached} {Consensus} on {Distributed} {Consensus}?},
	isbn = {978-1-4503-7524-5},
	url = {https://dl.acm.org/doi/10.1145/3380787.3393681},
	doi = {10.1145/3380787.3393681},
	abstract = {Distributed consensus is a fundamental primitive for constructing fault-tolerant, strongly-consistent distributed systems. Though many distributed consensus algorithms have been proposed, just two dominate production systems: Paxos, the traditional, famously subtle, algorithm; and Raft, a more recent algorithm positioned as a more understandable alternative to Paxos. In this paper, we consider the question of which algorithm, Paxos or Raft, is the better solution to distributed consensus? We analyse both to determine exactly how they differ by describing a simplified Paxos algorithm using Raft's terminology and pragmatic abstractions. We find that both Paxos and Raft take a very similar approach to distributed consensus, differing only in their approach to leader election.},
	language = {en},
	booktitle = {Proceedings of the 7th {Workshop} on {Principles} and {Practice} of {Consistency} for {Distributed} {Data} ({PaPoC} '20)},
	publisher = {ACM},
	author = {Howard, Heidi and Mortier, Richard},
	month = apr,
	year = {2020},
	pages = {1--9},
	file = {PDF:/home/pdampani/Zotero/storage/LDH7AM/Howard and Mortier - 2020 - Paxos vs Raft Have we reached consensus on distributed consensus.pdf:application/pdf},
}

@inproceedings{tollman_epaxos_2021,
	title = {{EPaxos} {Revisited}},
	url = {https://www.usenix.org/conference/nsdi21/presentation/tollman},
	abstract = {This paper re-evaluates the performance of the EPaxos consensus protocol for geo-replication and proposes an enhancement that uses synchronized clocks to reduce operation latency. The benchmarking approach used for the original EPaxos evaluation does not trigger or measure the full impact of conflict behavior on system performance. Our re-evaluation confirms that EPaxos provides optimal wide-area latency under low conflict but finds that under moderate-to-high conflict, EPaxos's latency and throughput can degrade substantially.},
	language = {en},
	booktitle = {18th {USENIX} {Symposium} on {Networked} {Systems} {Design} and {Implementation} ({NSDI} '21)},
	publisher = {USENIX Association},
	author = {Tollman, Sarah and Park, Seo Jin and Ousterhout, John},
	month = apr,
	year = {2021},
	file = {PDF:/home/pdampani/Zotero/storage/LOAT/Tollman et al. - 2021 - EPaxos Revisited.pdf:application/pdf},
}

