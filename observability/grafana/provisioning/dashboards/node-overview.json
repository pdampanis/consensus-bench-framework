{
  "uid": "node-overview",
  "title": "Node Overview (health & validity)",
  "tags": ["consensus-bench", "starter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(node_uname_info, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU busy %  (validity gate 1: loadgen < 70%)",
      "description": "Fraction of each node's CPU that is NOT idle. High on a consensus node at saturation is expected; high on the LOADGEN means the measuring instrument is the bottleneck and the run is invalid.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU steal %  (validity gate 4: dedicated vCPU should be ~0)",
      "description": "Time the hypervisor stole from this VM. On dedicated vCPUs (consensus nodes, loadgen) this must sit near zero; a spike means a noisy neighbour corrupted the measurement — the run is a validity threat.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (instance) (rate(node_cpu_seconds_total{mode=\"steal\", instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory used %",
      "description": "1 - available/total. Watch for a climb across a long run (a leak) or a ceiling (paging, which wrecks tails).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network throughput (rx/tx, real NIC)",
      "description": "Bytes/s in and out, excluding loopback and docker interfaces. On a consensus node this is the replication traffic; a sudden drop to zero during a fault run is what a kill/partition looks like.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*\", instance=~\"$instance\"}[1m])",
          "legendFormat": "rx {{instance}} {{device}}"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|docker.*\", instance=~\"$instance\"}[1m])",
          "legendFormat": "tx {{instance}} {{device}}"
        }
      ]
    }
  ]
}
