# PDFs — large binary files, not needed in version control
*.pdf

# Lock files, temp files
*.lock
*.lock#
~$*
.~lock*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes / data dirs (generated at runtime)
results/
prom-data/
grafana-data/
cmt-testnet/
hotstuff-work/

# Analysis outputs (generated by analyse.py)
analysis/out/
analysis/plots/

# Node modules
node_modules/

# Java build artifacts
target/
*.class
*.jar

# Logs
*.log
batch.log
campaign.log

# Environment files with secrets
inventory.env
.env

# Backup files
*.bak
*.backup
