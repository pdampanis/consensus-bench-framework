# =============================================================================
# inventory.env — Hetzner cluster configuration
# =============================================================================
#
# Fill in the private IPs from your Hetzner console (Networking tab on
# each server) and the path to your SSH private key. The private IPs
# are 10.0.0.x addresses assigned by Hetzner's network.
#
# To get the IPs via CLI:
#   for name in node1 node2 node3 node4 loadgen; do
#     echo "$name: $(hcloud server describe "thesis-$name" -o json | jq -r '.private_net[0].ip')"
#   done
# =============================================================================

# Private IPs (inter-node communication)
NODE1=10.0.0.2
NODE2=10.0.0.3
NODE3=10.0.0.4
NODE4=10.0.0.5
LOADGEN=10.0.0.6

# Public IPs (used by deploy scripts for SSH/bootstrap, then switched to private)
NODE1_PUBLIC=
NODE2_PUBLIC=
NODE3_PUBLIC=
NODE4_PUBLIC=
LOADGEN_PUBLIC=

# SSH key for accessing all nodes (user is always root on Hetzner Ubuntu)
SSH_KEY=~/.ssh/hetzner_thesis

# SSH user (root on Hetzner Ubuntu, may differ on other providers)
SSH_USER=root

# Docker image tag for custom images
IMAGE_TAG=thesis-v5

# Results directory on loadgen (absolute path)
REMOTE_THESIS_DIR=/root/thesis-final

# Local directory where results will be downloaded
LOCAL_RESULTS_DIR=./results-hetzner
